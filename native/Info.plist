<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GitSha</key>
	<string>$(GIT_SHA)</string>
	<key>BugKitCommit</key>
	<string>$(BUGKIT_COMMIT)</string>
	<key>BugKitRepositoryURL</key>
	<string>https://github.com/idvorkin/context-grabber</string>
	<key>GitBranch</key>
	<string>$(GIT_BRANCH)</string>
	<!-- Story 238: the shared pairing item's access group, with the team prefix the signed build fills in. -->
	<key>PairedDeviceAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.idvorkin.paired-device</string>
	<!-- #1012: only the system's own encryption (HTTPS), which is exempt; without this TestFlight asks about export
	     compliance before every build can be tested. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Grabber Native uses the microphone for calls with Larry, to speak a message in Chat, to speak a problem report and to talk to the whiteboard.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speaking turns your words into text, on the device when it can. In Chat or a problem report you read it before it goes; on the whiteboard it goes to your Cockpit straight away.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Grabber Native reads your steps, heart rate, sleep, workouts, mindful minutes and weight to show your week and share it with your coach.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Box breathing sessions are saved to Health as Mindful Minutes. Nothing else is written (the simulator's test week aside).</string>
	<!-- Story 821: Save Image in a chat picture's share sheet adds it to Photos; without this key the save crashes. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save Image puts a picture from a chat into your photos.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Story 270: the archive's four-hourly refresh and its end-of-day batch (ArchiveSchedule names the same two). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.idvorkin.grabbernative.archive.refresh</string>
		<string>com.idvorkin.grabbernative.archive.daily</string>
		<string>com.idvorkin.grabbernative.chat</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Places shows where you are on the map and can name a place from where you stand.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Background Tracking on, Places records where you go while the app is closed, so your days read as time at named places. The trail stays on this phone.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Context Grabber database</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.idvorkin.grabber.database</string>
				<string>public.database</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.idvorkin.grabber.database</string>
			<key>UTTypeDescription</key>
			<string>SQLite database</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.database</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>db</string>
					<string>sqlite</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-sqlite3</string>
					<string>application/vnd.sqlite3</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Stories 1088-1089: Live heart rate on calls asks canOpenURL whether Exercise Analyzer is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>exerciseanalyzer</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.idvorkin.grabbernative</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Not grabber: Context Grabber owns it until the cutover (story 135). -->
				<string>grabbernative</string>
				<!-- Story 744: larry://inbox/<key>, a Cockpit thread as Larry writes it in a chat. -->
				<string>larry</string>
			</array>
		</dict>
	</array>
	<!-- #634: windows on the iPad. A phone reads this and still has one. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
