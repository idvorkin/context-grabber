<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GitSha</key>
	<string>$(GIT_SHA)</string>
	<key>GitBranch</key>
	<string>$(GIT_BRANCH)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Grabber Native uses the microphone for calls with Larry.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Grabber Native reads your steps, heart rate, sleep, workouts, mindful minutes and weight to show your week and share it with your coach.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Only the simulator's test week is ever written to Health; the app on your phone never writes.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Places shows where you are on the map and can name a place from where you stand.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Background Tracking on, Places records where you go while the app is closed, so your days read as time at named places. The trail stays on this phone.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Context Grabber database</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.idvorkin.grabber.database</string>
				<string>public.database</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.idvorkin.grabber.database</string>
			<key>UTTypeDescription</key>
			<string>SQLite database</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.database</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>db</string>
					<string>sqlite</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-sqlite3</string>
					<string>application/vnd.sqlite3</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.idvorkin.grabbernative</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Not grabber: Context Grabber owns it until the cutover (story 135). -->
				<string>grabbernative</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
